NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ADMIN:ADMIN@localhost:5434/oidc_auth
ISSUER_URL=http://localhost:3000
CONSENT_UI_URL=http://localhost:5173
# Optional additional browser API origins; the consent UI origin is included automatically.
# Confidential clients exchanging tokens on their backend do not need CORS entries.
CORS_ALLOWED_ORIGINS=
# Legacy CLIENT is accepted as an alias for CONSENT_UI_URL.
# SERVER is used by the local verification script, not by discovery or token signing.
SERVER=http://localhost:3000
PRIVATE_KEY=
PUBLIC_KEY=  
