NODE_ENV=development
PORT=3000
# Set to the exact number of trusted reverse proxies in hosted environments.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://ADMIN:ADMIN@localhost:5434/oidc_auth
ISSUER_URL=http://localhost:3000
CONSENT_UI_URL=http://localhost:5173
# Optional additional browser API origins; the consent UI origin is included automatically.
# Confidential clients exchanging tokens on their backend do not need CORS entries.
CORS_ALLOWED_ORIGINS=
# Legacy CLIENT is accepted as an alias for CONSENT_UI_URL.
# SERVER is used by the local verification script, not by discovery or token signing.
SERVER=http://localhost:3000
PRIVATE_KEY=
PUBLIC_KEY=  

# Mailtrap Sandbox / SMTP. Without EMAIL_PROVIDER, a RESEND_API_KEY selects
# Resend automatically; otherwise SMTP is used. Credentials stay server-side.
EMAIL_PROVIDER=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Identity <no-reply@example.com>
# SMPT_PASSWORD is also accepted for compatibility with the existing local config.

# To switch to Resend, set EMAIL_PROVIDER=resend and these two values:
# RESEND_API_KEY=
# EMAIL_FROM=Identity <no-reply@your-verified-domain.com>
